{
    "name": "Universal Wish List",
    "version": "1.0",
    "description": "An extension for adding items to lists in Universal Wish List",
    "browser_specific_settings": {
        "gecko": {
            "id": "firefox-extension@universalwishlist.org",
            "data_collection_permissions": {
                "required": ["authenticationInfo", "browsingActivity"]
            }
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self';"
    },
    "permissions": ["tabs", "storage"],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "scripts": ["service-worker.js"],
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "assets/Wishlist_logo.png"
    },
    "manifest_version": 3
}